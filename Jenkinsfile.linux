pipeline {
    agent any

    environment {
        // CHANGE THIS to your own Docker Hub username
        DOCKERHUB_USER = 'YOUR_DOCKERHUB_USERNAME'
        IMAGE          = "${DOCKERHUB_USER}/temp-converter"
    }

    // SCM trigger: Jenkins checks GitHub every 2 minutes and builds if there is a new commit
    triggers {
        pollSCM('H/2 * * * *')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test (inside Docker)') {
            steps {
                // Compiles, runs JUnit tests and builds the image. Fails if a test fails.
                sh 'docker build -t $IMAGE:$BUILD_NUMBER -t $IMAGE:latest .'
            }
        }

        stage('Security Scan (Trivy)') {
            steps {
                // Reports HIGH/CRITICAL vulnerabilities. exit-code 0 = report only, don't fail the build.
                sh '''
                  docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \
                    aquasec/trivy:latest image --severity HIGH,CRITICAL --exit-code 0 $IMAGE:$BUILD_NUMBER
                '''
            }
        }

        stage('Run Container') {
            steps {
                sh 'docker run --rm $IMAGE:$BUILD_NUMBER'
                sh 'docker run --rm $IMAGE:$BUILD_NUMBER c2f 100'
            }
        }

        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds',
                                                  usernameVariable: 'DH_USER',
                                                  passwordVariable: 'DH_PASS')]) {
                    sh '''
                      echo "$DH_PASS" | docker login -u "$DH_USER" --password-stdin
                      docker push $IMAGE:$BUILD_NUMBER
                      docker push $IMAGE:latest
                    '''
                }
            }
        }
    }

    post {
        success { echo 'Pipeline succeeded: image built, scanned and pushed.' }
        failure { echo 'Pipeline FAILED: check the console output.' }
        always  { sh 'docker logout || true' }
    }
}
